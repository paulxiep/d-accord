# Root-level scratch markdown — default to ignore, README.md is the exception
/*.md
!/README.md
.claude/

# Python
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.venv/
# Per-env venvs for tier sub-projects (e.g. envs/bakeoff/.venv for tier 2D).
# Each envs/<tier>/ is an independent uv project with its own lockfile + venv.
envs/*/.venv/
build/
dist/

# Environment / secrets
.env
.env.local
*.secret
# AWS — account-specific config gitignored; share aws-account.yaml.sample
# instead. Per-setup outputs and raw access keys never committed.
/aws-account.yaml
aws-credentials*
*.access_keys*
/data/aws_*

# MLflow tracking
mlruns/
mlartifacts/

# Notebooks
.ipynb_checkpoints/

# Data — raw PDFs gitignored (sourced via scripts/download_corpus.py +
# data/sources.yaml); ensemble + tiering + splits gitignored (regenerated).
# Parsed markdown (data/ingest/) IS committed: ~4 MB total, unblocks tier 5+
# work for contributors without a GPU (re-parsing requires Marker + ~37 min).
# Per-framework citation registries (data/registry/, tier 5) ARE committed:
# ~30 KB total, deterministic from the parsed markdown + extractor version,
# and consumed as input by tier 6A's ensemble JSON-schema constraint.
# Only data/gold/ (hand-validated mapping pairs) + per-stage manifests are
# committed for the other stages.
/data/raw/
/data/parsed/
/data/ensemble/
/data/tiering/
/data/splits/
# Regenerable derivatives — gitignored to keep history lean; CHEAPLY rebuilt from
# committed inputs (data/registry/ + data/ingest/) via committed scripts. See
# data/README.md "Regenerating the gitignored derivatives" for commands:
#   data/clauses/ ← scripts/extract_clauses.py            (byte-identical; CPU)
#   data/indices/ ← envs/eval/scripts/build_target_indices.py  (FAISS; CPU)
/data/clauses/
/data/indices/
# NOTE: data/training/ is intentionally COMMITTED (not ignored). It's the small
# (~4 MB) distilled trainer input (summary target); its upstream
# data/ensemble/tiered/ (84 MB) is gitignored + ~$32 to rebuild, so committing the
# distillate keeps training reproducible on a fresh clone and version-controls the
# MLflow dataset_hash. data/gold/ is committed for the same reason.
/data/gold/snapshots/
# Gold drafter intermediate outputs (LLM proposals before human reconcile/verify)
/data/gold/*.draft_*.jsonl

# Parser bake-off (tier 2D): per-page parser outputs + rasterized images are
# large and reproducible. Only the M1 artifacts are committed:
#   sample_pages.json, expected_citation_ids.json, score_table.csv, summary.md
/data/parser_bakeoff/marker/
/data/parser_bakeoff/typhoon/
/data/parser_bakeoff/page_images/

# Costs — inflight sqlite log and lock files; daily.csv + config.toml are committed
/costs/inflight.sqlite
/costs/inflight.sqlite-*
/costs/*.lock

# Models — never commit weights/adapters
/models/
*.bin
*.safetensors
*.gguf
*.pt
*.pth
adapter/
checkpoints/

# Training artifacts
/training/runs/
/training/outputs/
/training/logs/

# Eval outputs — raw traces gitignored; results.csv committed
/eval/traces/
/eval/raw/

# Publish staging
/publish/staging/

# Caravan-generated (mirrors code-rag pattern)
/infra/
/caravan.exe

# Cache
/.cache/
.fastembed_cache/

# Editors / OS
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
*~
